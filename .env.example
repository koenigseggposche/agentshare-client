# AgentShare Client public build configuration.
# Copy to .env, then set only the destinations approved for this deployment.
# Keep credentials and runtime state outside the checkout.

# Account service used by the mobile app. Use the same Console as the host Core.
# EXPO_PUBLIC_AGENTSHARE_CONSOLE_URL=https://console.example.com/console

# Optional self-hosted connection service. Configure these together for your
# own deployment; direct host pairing works without a cloud identity service.
# T3CODE_CLERK_PUBLISHABLE_KEY=
# T3CODE_CLERK_JWT_TEMPLATE=
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=
# T3CODE_RELAY_URL=https://relay.example.com
# T3CODE_HOSTED_APP_URL=https://client.example.com

# Optional distribution signing and passkey configuration.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/client.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=identity.example.com

# Optional diagnostics receiver. Enable only for your own approved destination.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://telemetry.example.com/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=client-mobile
# T3CODE_RELAY_CLIENT_OTLP_TRACES_URL=https://telemetry.example.com/v1/traces
# T3CODE_RELAY_CLIENT_OTLP_TRACES_DATASET=client-relay
